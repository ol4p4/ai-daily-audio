# 安全警告：不要在此文件或任何提交中写入真实 API Key。
# 真实配置请使用 GitHub Secrets 或本地 .env（.env 已加入 .gitignore）。

# ========== 邮件 SMTP ==========
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
EMAIL_USER=your_email@outlook.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=your_email@outlook.com
EMAIL_FROM=your_email@outlook.com

# ========== TTS ==========
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+25%

# ========== 新闻源（全球源：通讯社/财经/政策/科技） ==========
NEWS_SOURCES=https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_SOURCES+=https://rss.nytimes.com/services/xml/rss/nyt/World.xml
NEWS_SOURCES+=https://feeds.reuters.com/reuters/topNews
NEWS_SOURCES+=https://feeds.reuters.com/reuters/businessNews
NEWS_SOURCES+=https://feeds.reuters.com/reuters/technologyNews
NEWS_SOURCES+=https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_SOURCES+=https://www.cnbc.com/id/100003114/device/rss/rss.html
NEWS_SOURCES+=https://www.federalreserve.gov/feeds/press_all.xml
NEWS_SOURCES+=https://www.theverge.com/rss/index.xml
NEWS_SOURCES+=https://hnrss.org/frontpage

# ========== LLM（NVIDIA NIM，OpenAI 兼容接口，key 从 build.nvidia.com 获取） ==========
OPENAI_API_KEY=你的nvidia密钥（nvapi-xxx）
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ========== 限制 ==========
MAX_NEWS_PER_DAY=30
MAX_AUDIO_DURATION_MINUTES=8
